{
  "manifest_version": 3,
  "name": "Auto Download Converter",
  "version": "1.0.0",
  "description": "Automatically converts downloaded files to a format you choose, using rules you control. Runs locally - files are never uploaded.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "downloads",
    "storage",
    "notifications",
    "nativeMessaging",
    "contextMenus"
  ],
  "minimum_chrome_version": "116"
}
